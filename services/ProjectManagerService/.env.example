# ProjectManagerService — variables de entorno
# Copia este archivo a `.env` (o exporta las variables) antes de arrancar.

# ── Almacenamiento S3 (adjuntos de issues) ───────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
PM_S3_BUCKET=adc-pm

# ── Tableros de tickets ──────────────────────────────────────────────────────
# Los valores son el SLUG (no el id) de proyectos globales (orgId null). Si no
# existen se crean solos: el servicio reconcilia cada tablero a sus columnas y
# campos canónicos (agrega faltantes, borra sobrantes) en cada arranque Y al crear
# un ticket, y reasigna issues huérfanos a la columna default.
#
# Tablero de solicitudes de organización (columnas: organizations, done).
ORG_MANAGEMENT_PROJECT_ID=pm-org-management-001
# Tablero de tickets de soporte / bug bounty
# (columnas: support, security, expansion, in_progress, done, rejected).
# Debe ser un proyecto DISTINTO al de org-requests; si se omite cae en
# ORG_MANAGEMENT_PROJECT_ID y ambos tableros colisionan.
PM_SUPPORT_TICKETS_PROJECT_ID=pm-support-tickets
# (opcional) Override explícito del tablero de org-requests; si se omite usa ORG_MANAGEMENT_PROJECT_ID.
# PM_ORG_REQUESTS_PROJECT_ID=

# Límite de adjuntos referenciables por descripción de issue (default 10)
# ISSUE_DESCRIPTION_MAX_ATTACHMENTS=10
