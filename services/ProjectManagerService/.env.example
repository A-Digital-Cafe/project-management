# ProjectManagerService — variables interpoladas en config.json
# (Mongo y credenciales S3 se configuran en el `.env` de la raíz; la base es
# `project-management`.)

# ── Almacenamiento S3 (adjuntos de issues) ───────────────────────────────────
PM_S3_BUCKET=adc-pm

# ── Tableros de tickets ──────────────────────────────────────────────────────
# Los valores son el SLUG (no el id) de proyectos globales (orgId null). Si no
# existen se crean solos: el servicio reconcilia cada tablero a sus columnas y
# campos canónicos (agrega faltantes, borra sobrantes) en cada arranque Y al crear
# un ticket, y reasigna issues huérfanos a la columna default.
#
# Tablero de solicitudes de organización (columnas: organizations, done).
ORG_MANAGEMENT_PROJECT_ID=pm-org-management-001
# Tablero de tickets de soporte / bug bounty
# (columnas: support, security, authority, expansion, in_progress, done,
#  duplicate, rejected).
# Debe ser un proyecto DISTINTO al de org-requests; si se omite cae en
# ORG_MANAGEMENT_PROJECT_ID y ambos tableros colisionan.
PM_SUPPORT_TICKETS_PROJECT_ID=pm-support-tickets
# (opcional) Override explícito del tablero de org-requests. Vacío = cae en
# ORG_MANAGEMENT_PROJECT_ID (el código resuelve la prioridad; el config.json no puede,
# porque la interpolación es de un solo nivel y no admite fallbacks anidados).
PM_ORG_REQUESTS_PROJECT_ID=

# Límite de adjuntos referenciables por descripción de issue (default 10)
# ISSUE_DESCRIPTION_MAX_ATTACHMENTS=10

# ── Retención de tickets de soporte ──────────────────────────────────────────
# Barrido en momentos ociosos (OperationsService) que anonimiza y luego purga los
# tickets vencidos según SUPPORT_TICKET_RETENTION. Los PLAZOS no se configuran acá:
# son los que publica /privacy y viven en el código. Esto sólo regula el ritmo.
# Sin OperationsService cargado el barrido no corre (se loguea un warning).
# PM_TICKET_RETENTION_INTERVAL_SECONDS=3600
# PM_TICKET_RETENTION_BATCH_SIZE=50
# PM_TICKET_RETENTION_BATCH_BUDGET_MS=3000
