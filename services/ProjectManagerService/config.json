{
	"name": "ProjectManagerService",
	"uiName": "Proyectos",
	"privileges": [
		"identity:internal",
		"storage:register",
		"plans:register",
		"idle:register",
		"audit:write"
	],
	"version": "1.0.0",
	"failOnError": false,
	"providers": [
		{
			"name": "object/mongo",
			"version": "latest",
			"language": "typescript",
			"custom": {
				"host": "${MONGO_HOST:-localhost:27017}",
				"user": "${MONGO_USER:-admin}",
				"password": "${MONGO_PASSWORD:-password}",
				"options": "${MONGO_OPTIONS:-authSource=admin}",
				"db": "project-management",
				"maxRetries": 5,
				"retryDelay": 5000
			}
		},
		{
			"name": "object/internal-s3-provider",
			"version": "latest",
			"language": "typescript",
			"custom": {
				"endpoint": "${S3_ENDPOINT:-http://localhost:9000}",
				"region": "${S3_REGION:-us-east-1}",
				"accessKey": "${S3_ACCESS_KEY:-adc-platform}",
				"secretKey": "${S3_SECRET_KEY:-adc-platform-dev}",
				"forcePathStyle": true,
				"defaultBucket": "${PM_S3_BUCKET:-adc-pm}",
				"presignTtl": 600
			}
		}
	],
	"utilities": [
		{
			"name": "attachments/attachments-utility",
			"version": "latest",
			"language": "typescript"
		},
		{
			"name": "comments/comments-utility",
			"version": "latest",
			"language": "typescript"
		}
	],
	"services": [
		{
			"name": "IdentityManagerService",
			"version": "latest"
		},
		{
			"name": "EndpointManagerService",
			"version": "latest"
		},
		{
			"name": "OperationsService",
			"version": "latest",
			"optional": true
		},
		{
			"name": "AuditLogService",
			"version": "latest",
			"optional": true
		},
		{
			"name": "StorageQuotaService",
			"version": "latest",
			"optional": true
		},
		{
			"name": "PlanService",
			"version": "latest",
			"optional": true
		}
	],
	"private": {
		"orgManagementProjectId": "${ORG_MANAGEMENT_PROJECT_ID}",
		"organizationRequestsProjectId": "${PM_ORG_REQUESTS_PROJECT_ID}",
		"supportTicketsProjectId": "${PM_SUPPORT_TICKETS_PROJECT_ID}",
		"ticketRetentionIntervalSeconds": "${PM_TICKET_RETENTION_INTERVAL_SECONDS:-3600}",
		"ticketRetentionBatchSize": "${PM_TICKET_RETENTION_BATCH_SIZE:-50}",
		"ticketRetentionBatchBudgetMs": "${PM_TICKET_RETENTION_BATCH_BUDGET_MS:-3000}"
	}
}
